# Server Configuration
PORT=5000
NODE_ENV=development

# Database Provider ('supabase' uses cloud PostgreSQL; 'mysql' uses local MySQL)
DB_TYPE=supabase

# Supabase project and PostgreSQL connection
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# Local MySQL Configuration (used when DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=poojapa_db
DB_PORT=3306

# JWT Authentication
JWT_SECRET=poojapa_sacred_secret_jwt_key_2026_mkcreation
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
